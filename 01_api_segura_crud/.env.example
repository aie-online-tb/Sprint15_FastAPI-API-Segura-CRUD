# Copiad a .env y poned un valor (no subáis .env al repo)
API_KEY=cambia-esta-clave

# Bajo a propósito: fácil forzar 429 en la práctica
RATE_LIMIT_PER_MINUTE=10

# Orígenes del front / clientes web (separados por coma). Cambiad según el entorno.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8501,http://localhost:3000
